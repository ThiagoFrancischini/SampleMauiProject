<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SampleProject.Views.MainPage"
             xmlns:local="clr-namespace:SampleProject.ViewModels"
             xmlns:models="clr-namespace:SampleProject.Models"
             x:DataType="local:MainViewModel"
             Title="MainPage">

    <Grid RowDefinitions="*, Auto">
        <CollectionView ItemsSource="{Binding Items}" Grid.Row="0">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:TravelEntry">
                    
                    <Border Margin="10,5" Padding="10">
                        <HorizontalStackLayout Spacing="15">
                            <Image Source="{Binding ImagePath}" WidthRequest="50" HeightRequest="50" Aspect="AspectFill" />
                            <VerticalStackLayout>
                                <Label Text="{Binding Title}" FontAttributes="Bold" />
                                <Label Text="{Binding Category}" FontSize="Small" TextColor="Gray" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer 
                                Command="{Binding Source={RelativeSource AncestorType={x:Type local:MainViewModel}}, Path=EditEntryCommand}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                    </Border>
                    
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Text="Novo Registro" 
                Command="{Binding GoToAddPageCommand}"
                Grid.Row="1" 
                Margin="20" />
    </Grid>
</ContentPage>